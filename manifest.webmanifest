{
  "id": "./",
  "name": "PlayBox Party Edition",
  "short_name": "PlayBox",
  "description": "Party games para jogar com a galera, no mesmo lugar ou à distância.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0B0B0F",
  "theme_color": "#0B0B0F",
  "categories": [
    "games",
    "entertainment"
  ],
  "icons": [
    {
      "src": "playbox-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "playbox-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "playbox-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "playbox-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://lucca14br.github.io/playbox/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}
